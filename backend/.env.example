# Copy this file to .env and adjust if needed.
# The defaults below already work for a standard local Ollama install, so an
# empty .env (or no .env at all) is fine.
#
# NEVER put a real API key in THIS file — it is the committed template.
# Real values belong in .env, which is not committed.

# ---------------------------------------------------------------------------
# Which model backend to use.
#   ollama = fully local, nothing leaves this machine   (default)
#   gemini = legacy cloud path, kept only for comparison
# ---------------------------------------------------------------------------
VLM_PROVIDER=ollama

# ---------------------------------------------------------------------------
# Local model (VLM_PROVIDER=ollama)
# ---------------------------------------------------------------------------
OLLAMA_URL=http://localhost:11434

# Must be an "-instruct" tag. The plain qwen3-vl:4b tag is the *thinking*
# variant: it burns 300-400 tokens on reasoning and returns an EMPTY response
# when structured output (JSON schema) is requested.
# Use qwen3-vl:2b-instruct instead if 4b is too slow on your machine.
OLLAMA_MODEL=qwen3-vl:4b-instruct

# How long to wait for one analysis. The first request after Ollama starts is
# the slowest because the model has to be loaded into memory (~9s).
OLLAMA_TIMEOUT_MS=120000

# ---------------------------------------------------------------------------
# Legacy cloud path — only read when VLM_PROVIDER=gemini
# ---------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# ---------------------------------------------------------------------------
PORT=8787
